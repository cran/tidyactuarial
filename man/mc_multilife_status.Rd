  simulate_lifetimes(
    ages = c(60, 58, 55),
    life_id = c("x", "y", "z"),
    n_sim = 25,
    seed = 123
  )

# Time until the second death among three lives
mc_multilife_status(
  sim_three,
  status = "kth_death",
  k = 2
)

